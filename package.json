{
  "name": "reworkguard",
  "version": "1.0.0",
  "description": "ReworkGuard — Bug Accountability and Rework Cost Tracker",
  "main": "server/index.ts",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"CLIENT,SERVER\" -c \"cyan.bold,yellow.bold\" \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "vite",
    "dev:server": "tsx watch --ignore 'server/*.json' --ignore 'server/.reworkguard-data.json' server/index.ts",
    "build": "tsc && vite build",
    "start": "tsx server/index.ts",
    "db:init": "tsx server/init-db.ts",
    "db:sync": "tsx server/scripts/sync-to-supabase.ts",
    "db:verify": "tsx server/scripts/verify-supabase-workflow.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "lucide-react": "^1.16.0",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
