# ====================================================================
# ReworkGuard — Environment Configuration Template
# Copy this file to .env and configure your values.
# ====================================================================

# Backend Server Port (default: 5001)
PORT=5001

# Frontend Vite Port (default: 3000)
VITE_PORT=3000

# --------------------------------------------------------------------
# Supabase Configuration
# --------------------------------------------------------------------
VITE_SUPABASE_URL=https://jfeveaptdeqniyriwcbc.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<NEW_SUPABASE_PUBLISHABLE_KEY_IF_AVAILABLE>
VITE_SUPABASE_ANON_KEY=<EXISTING_PROJECT_ANON_KEY_IF_REQUIRED>

SUPABASE_URL=https://jfeveaptdeqniyriwcbc.supabase.co
SUPABASE_ANON_KEY=<EXISTING_PROJECT_ANON_KEY_IF_REQUIRED>
SUPABASE_PROJECT_ID=jfeveaptdeqniyriwcbc

# --------------------------------------------------------------------
# PostgreSQL / Supabase Database Direct Persistence
# --------------------------------------------------------------------
# Supabase Transaction / Direct Connection string format:
# postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require
# Or Supabase connection pooler:
# postgres://postgres.[project-id]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=
